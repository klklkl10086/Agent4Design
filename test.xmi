          <packagedElement xmi:type="uml:Artifact" xmi:id="GUID+5f6ecfbe-6f5b-4b35-9e36-f0c60acf4691" name="CD_AppDataTransmRead" visibility="protected" clientDependency="GUID+fe7f771a-a4c7-484e-9dfc-7a6ea031b983 GUID+ea804fca-20f7-4d00-bbb6-8ed2648a6041 GUID+3357953c-6bcd-4f46-9ad2-b6f343dcaa06 GUID+e85797cf-97b1-4ccd-a1a9-02dc28355e82 GUID+15b91116-4418-4f0a-bee6-9f6b319c833a GUID+ced05292-5d12-4421-928c-3c947a82a17c GUID+e3e8f74b-993e-42ff-8e30-99c214283a68 GUID+fd6b5dd7-f877-45d4-8fc2-1874ee81e0d0 GUID+b2c6ca41-5618-4e65-a20e-0ff7a4e95e95 GUID+c9967f6f-db5c-4d11-9bd4-bd67ab439273 GUID+f4323be4-9791-4397-b306-922226ee70e3 GUID+bb730f22-2225-4c6e-99b6-990646755106">
            <ownedUseCase xmi:type="uml:UseCase" xmi:id="GUID+5190703d-489d-45ab-bf0a-ae5d34944b1e_UseCase">
              <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="GUID+5190703d-489d-45ab-bf0a-ae5d34944b1e_OpaqueBehavior">
                <ownedBehavior xmi:type="uml:Activity" xmi:id="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e" name="activity_CDAppRead_b_IsIdentifierSupported">
                  <ownedRule xmi:type="uml:Constraint" xmi:id="GUID+7467df35-4537-4bb2-a88d-6903948f8968_Container" name="ActivityDiagram" context="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e"/>
                  <node xmi:type="uml:OpaqueAction" xmi:id="GUID+fb3c17e7-89df-4d82-af45-0cf18a41665e" name="action_0" activity="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e" outgoing="GUID+a076a691-248d-4af8-91d5-4fc552c6f0ca" incoming="GUID+b2c94f41-bcec-4132-8f79-5b776fc5fd1f">
                    <body>Initialize the Identifier Index with ZERO. </body>
                  </node>
                  <node xmi:type="uml:OpaqueAction" xmi:id="GUID+62b0e9f9-2fb4-4985-9a56-93a88f171012" name="action_1" activity="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e" outgoing="GUID+9c87afd5-79b5-4f93-a61c-363f36d19628" incoming="GUID+a076a691-248d-4af8-91d5-4fc552c6f0ca GUID+32c211b2-d0d1-4659-9d03-8cc63ddb4e8f">
                    <body>Check if the Identifier Index is lower than the size of the Service 22 Data table and if the Identifier sent as parameter is not the same as the identifier from the Service 22 Table.</body>
                  </node>
                  <node xmi:type="uml:OpaqueAction" xmi:id="GUID+46fc2a0e-2eb7-40ff-8b82-e373a33c2907" name="action_2" activity="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e" outgoing="GUID+32c211b2-d0d1-4659-9d03-8cc63ddb4e8f" incoming="GUID+a22d2315-4f5c-4cba-aa4e-7877dc5ec642">
                    <body>Go to the next element on the table, increment the identifier index. </body>
                  </node>
                  <node xmi:type="uml:OpaqueAction" xmi:id="GUID+e9d9e7d4-8196-4936-8793-31b82f97ec97" name="action_3" activity="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e" outgoing="GUID+f8509d12-ee25-433a-8cd7-0c978dee119d" incoming="GUID+be34c1ea-56af-4f19-9009-f79a369e0b05">
                    <body>Check if the Identifier index is less than the Size of the Service 22 Table. </body>
