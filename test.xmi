  <RhapsodyProfile:RhpModelElement xmi:id="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e_Stereotype_RhapsodyProfile_RhpModelElement" guid="GUID 632523eb-f598-41e1-9619-91fcb7f08e7e" description="Purpose&#xD;&#xA;This activity describes a function that is used to check if a data identifier is supported or not by the UDS service 22.&#xD;&#xA;&#xD;&#xA;Return value&#xD;&#xA;b_TRUE means that the data identifier is supported&#xD;&#xA;b_FALSE means that the data identifier is not supported" descriptionHTML="&lt;![[CDATA[Purpose&#xD;&#xA;This activity describes a function that is used to check if a data identifier is supported or not by the UDS service 22.&#xD;&#xA;&#xD;&#xA;Return value&#xD;&#xA;b_TRUE means that the data identifier is supported&#xD;&#xA;b_FALSE means that the data identifier is not supported]]>" descriptionRTF="&lt;![[CDATA[{\rtf1\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}&#xD;&#xA;\viewkind4\uc1\pard\b\fs20 Purpose\par&#xD;&#xA;\b0 This activity describes a function that is used to check if a data identifier is supported or not by the UDS service 22.\par&#xD;&#xA;\par&#xD;&#xA;\b Return value\par&#xD;&#xA;\b0 b_TRUE means that the data identifier is supported\par&#xD;&#xA;b_FALSE means that the data identifier is not supported\par&#xD;&#xA;}]]>" base_Class="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e"/>
  <RHP:RHPStereotype xmi:id="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e_Stereotype_RHP_RHPStereotype" SpecificationFilename="D:\project_design\GTMC_V57_CD\workspace\ACU_Project_L3_SW_CD_AM\DefaultComponent\DefaultConfig\CD_AppDataTransmRead.h" ImplementationFilename="D:\project_design\GTMC_V57_CD\workspace\ACU_Project_L3_SW_CD_AM\DefaultComponent\DefaultConfig\CD_AppDataTransmRead.cpp" IsBeingGenerated="TRUE" base_Class="GUID+632523eb-f598-41e1-9619-91fcb7f08e7e"/>
  <RhapsodyProfile:RhpModelElement xmi:id="GUID+31934a7a-d2fe-4a11-b1f1-80f37cf1a606_Stereotype_RhapsodyProfile_RhpModelElement" guid="GUID 31934a7a-d2fe-4a11-b1f1-80f37cf1a606" description="Purpose&#xD;&#xA;This function is used to read data from the NVM.&#xD;&#xA;&#xD;&#xA;Range&#xD;&#xA;CDAppType_t_E_OK - operation was successful&#xD;&#xA;CDAppType_t_E_PENDING - operation is not done yet" descriptionHTML="&lt;![[CDATA[Purpose&#xD;&#xA;This function is used to read data from the NVM.&#xD;&#xA;&#xD;&#xA;Range&#xD;&#xA;&lt;a href=&quot;#GUID caf4a7b0-abac-43e2-a66a-41d9c6b7b691&quot;>CDAppType_t_E_OK&lt;/a> - operation was successful&#xD;&#xA;&lt;a href=&quot;#GUID e5e99a84-293f-4061-bbee-1e665e2c7cc1&quot;>CDAppType_t_E_PENDING&lt;/a> - operation is not done yet]]>" descriptionRTF="&lt;![[CDATA[{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1033{\fonttbl{\f0\fnil\fcharset0 Arial;}}&#xD;&#xA;{\colortbl ;\red0\green0\blue255;}&#xD;&#xA;\viewkind4\uc1\pard\ltrpar\b\fs20 Purpose\par&#xD;&#xA;\b0 This function is used to read data from the NVM.\par&#xD;&#xA;\par&#xD;&#xA;\b Range\b0\par&#xD;&#xA;\cf1\ul\protect CDAppType_t_E_OK\cf0\ulnone\protect0  - operation was successful\par&#xD;&#xA;\cf1\ul\protect CDAppType_t_E_PENDING\cf0\ulnone\protect0  - operation is not done yet\par&#xD;&#xA;}&#xD;&#xA;]]>" base_Class="GUID+31934a7a-d2fe-4a11-b1f1-80f37cf1a606"/>
